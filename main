#include <SFML/Graphics.hpp>
#include <fstream>
#include <cstdlib>
#include <ctime>

using namespace std;
using namespace sf;

const int SIZE = 8;
const int CELL_SIZE = 60;
const int WINDOW_SIZE = (SIZE * CELL_SIZE);
const int MAX_MOVES = 100;

// Game states
const int STATE_MAIN_MENU = 0;
const int STATE_PLAYING = 1;
const int STATE_PLAYER_WON = 2;
const int STATE_PLAYER_LOST = 3;

int board[SIZE][SIZE];
int selectedR = -1, selectedC = -1;
int currentPlayer = 1;
int gameState = STATE_MAIN_MENU;

// Move storage: [moveIndex][0=r1, 1=c1, 2=r2, 3=c2]
int moves[MAX_MOVES][4];
int jumpMoves[MAX_MOVES][4];

void initBoard() {
    for (int r = 0; r < SIZE; r++) {
        for (int c = 0; c < SIZE; c++) board[r][c] = 0;
    }
    for (int r = 0; r < 3; r++)
        for (int c = 0; c < SIZE; c++)
            if ((r + c) % 2 == 1) board[r][c] = 2;
    for (int r = 5; r < SIZE; r++)
        for (int c = 0; c < SIZE; c++)
            if ((r + c) % 2 == 1) board[r][c] = 1;
}

void saveBoard(const char* path) {
    ofstream f(path);
    for (int r = 0; r < SIZE; r++) {
        for (int c = 0; c < SIZE; c++) f << board[r][c] << " ";
        f << "\n";
    }
}

bool loadBoard(const char* path) {
    ifstream f(path);
    if (!f.is_open()) return false;
    for (int r = 0; r < SIZE; r++)
        for (int c = 0; c < SIZE; c++) f >> board[r][c];
    return true;
}

bool inside(int r, int c) {
    return r >= 0 && r < SIZE && c >= 0 && c < SIZE;
}

bool isKing(int piece) {
    return piece == 3 || piece == 4; // 3 = Player 1 King, 4 = Player 2 King
}

int getPlayer(int piece) {
    if (piece == 1 || piece == 3) return 1;
    if (piece == 2 || piece == 4) return 2;
    return 0;
}

bool isValidMove(int r1, int c1, int r2, int c2, int player) {
    if (!inside(r2, c2) || board[r2][c2] != 0) {
        return false;
    }

    int piece = board[r1][c1];
    if (getPlayer(piece) != player) return false;

    int dr = r2 - r1;
    int dc = c2 - c1;
    int abs_dr = abs(dr);
    int abs_dc = abs(dc);

    // Single step diagonal move
    if (abs_dr == 1 && abs_dc == 1) {
        if (isKing(piece)) {
            return true; // Kings can move in any diagonal direction
        }
        // Regular pieces move only forward
        if ((player == 1 && dr == -1) || (player == 2 && dr == 1)) {
            return true;
        }
    }

    // Jump move (capture)
    if (abs_dr == 2 && abs_dc == 2) {
        if (isKing(piece)) {
            // Kings can jump in any direction
            int r_mid = r1 + dr / 2;
            int c_mid = c1 + dc / 2;
            int opponent = (player == 1) ? 2 : 1;
            int midPiece = board[r_mid][c_mid];
            if (getPlayer(midPiece) == opponent) {
                return true;
            }
        }
        else {
            // Regular pieces jump only forward
            if ((player == 1 && dr == -2) || (player == 2 && dr == 2)) {
                int r_mid = r1 + dr / 2;
                int c_mid = c1 + dc / 2;
                int opponent = (player == 1) ? 2 : 1;
                int midPiece = board[r_mid][c_mid];
                if (getPlayer(midPiece) == opponent) {
                    return true;
                }
            }
        }
    }

    return false;
}

bool makeMove(int r1, int c1, int r2, int c2, int player) {
    int piece = board[r1][c1];
    if (getPlayer(piece) == player && isValidMove(r1, c1, r2, c2, player)) {
        board[r2][c2] = piece;
        board[r1][c1] = 0;

        int dr = r2 - r1;
        int dc = c2 - c1;

        // Handle capture
        if (abs(dr) == 2 && abs(dc) == 2) {
            int r_mid = r1 + dr / 2;
            int c_mid = c1 + dc / 2;
            board[r_mid][c_mid] = 0;
        }

        // Promote to King
        if (player == 1 && r2 == 0 && piece == 1) {
            board[r2][c2] = 3; // Player 1 King
        }
        if (player == 2 && r2 == 7 && piece == 2) {
            board[r2][c2] = 4; // Player 2 King
        }

        return true;
    }
    return false;
}

void aiMove() {
    int moveCount = 0;
    int jumpCount = 0;

    for (int r = 0; r < SIZE; r++) {
        for (int c = 0; c < SIZE; c++) {
            int piece = board[r][c];
            if (getPlayer(piece) == 2) {
                // Check all possible moves for this piece
                int directions[4] = { -2, -1, 1, 2 };
                for (int i = 0; i < 4; i++) {
                    int dr = directions[i];
                    for (int j = 0; j < 4; j++) {
                        int dc = directions[j];
                        if (abs(dr) != abs(dc)) continue; // Only diagonals
                        int r2 = r + dr;
                        int c2 = c + dc;
                        if (isValidMove(r, c, r2, c2, 2)) {
                            if (abs(dr) == 2 && jumpCount < MAX_MOVES) {
                                jumpMoves[jumpCount][0] = r;
                                jumpMoves[jumpCount][1] = c;
                                jumpMoves[jumpCount][2] = r2;
                                jumpMoves[jumpCount][3] = c2;
                                jumpCount++;
                            }
                            if (moveCount < MAX_MOVES) {
                                moves[moveCount][0] = r;
                                moves[moveCount][1] = c;
                                moves[moveCount][2] = r2;
                                moves[moveCount][3] = c2;
                                moveCount++;
                            }
                        }
                    }
                }
            }
        }
    }

    if (moveCount == 0) return;

    // Prefer jump moves 50% of the time
    if (jumpCount > 0 && (rand() % 100) < 50) {
        int idx = rand() % jumpCount;
        makeMove(jumpMoves[idx][0], jumpMoves[idx][1],
            jumpMoves[idx][2], jumpMoves[idx][3], 2);
    }
    else {
        int idx = rand() % moveCount;
        makeMove(moves[idx][0], moves[idx][1],
            moves[idx][2], moves[idx][3], 2);
    }
}

bool hasValidMoves(int player) {
    for (int r = 0; r < SIZE; r++) {
        for (int c = 0; c < SIZE; c++) {
            int piece = board[r][c];
            if (getPlayer(piece) == player) {
                int directions[4] = { -2, -1, 1, 2 };
                for (int i = 0; i < 4; i++) {
                    int dr = directions[i];
                    for (int j = 0; j < 4; j++) {
                        int dc = directions[j];
                        if (abs(dr) != abs(dc)) continue;
                        int r2 = r + dr;
                        int c2 = c + dc;
                        if (isValidMove(r, c, r2, c2, player)) {
                            return true;
                        }
                    }
                }
            }
        }
    }
    return false;
}

bool hasAnyPieces(int player) {
    for (int r = 0; r < SIZE; r++) {
        for (int c = 0; c < SIZE; c++) {
            if (getPlayer(board[r][c]) == player) {
                return true;
            }
        }
    }
    return false;
}

void drawBoard(RenderWindow& window) {
    RectangleShape cell(Vector2f(static_cast<float>(CELL_SIZE), static_cast<float>(CELL_SIZE)));

    for (int r = 0; r < SIZE; r++) {
        for (int c = 0; c < SIZE; c++) {
            if ((r + c) % 2 == 0)
                cell.setFillColor(Color(240, 217, 181));
            else
                cell.setFillColor(Color(181, 136, 99));

            cell.setPosition(Vector2f(static_cast<float>(c * CELL_SIZE), static_cast<float>(r * CELL_SIZE)));
            window.draw(cell);
        }
    }

    if (selectedR != -1 && selectedC != -1) {
        RectangleShape highlight(Vector2f(static_cast<float>(CELL_SIZE), static_cast<float>(CELL_SIZE)));
        highlight.setPosition(Vector2f(static_cast<float>(selectedC * CELL_SIZE), static_cast<float>(selectedR * CELL_SIZE)));
        highlight.setFillColor(Color(255, 255, 0, 100));
        window.draw(highlight);

        int directions[4] = { -2, -1, 1, 2 };
        for (int i = 0; i < 4; i++) {
            int dr = directions[i];
            for (int j = 0; j < 4; j++) {
                int dc = directions[j];
                if (abs(dr) != abs(dc)) continue;
                int r2 = selectedR + dr;
                int c2 = selectedC + dc;

                if (isValidMove(selectedR, selectedC, r2, c2, currentPlayer)) {
                    CircleShape dot(8.f);
                    dot.setFillColor(Color(0, 255, 0, 150));
                    dot.setPosition(Vector2f(
                        static_cast<float>(c2 * CELL_SIZE + CELL_SIZE / 2 - 8),
                        static_cast<float>(r2 * CELL_SIZE + CELL_SIZE / 2 - 8)
                    ));
                    window.draw(dot);
                }
            }
        }
    }

    CircleShape piece(CELL_SIZE * 0.35f);
    piece.setOutlineThickness(2.f);
    piece.setOutlineColor(Color::Black);

    for (int r = 0; r < SIZE; r++) {
        for (int c = 0; c < SIZE; c++) {
            int p = board[r][c];
            if (p == 1 || p == 3) {
                piece.setFillColor(Color(220, 20, 20));
                piece.setPosition(Vector2f(
                    static_cast<float>(c * CELL_SIZE) + CELL_SIZE * 0.15f,
                    static_cast<float>(r * CELL_SIZE) + CELL_SIZE * 0.15f
                ));
                window.draw(piece);

                // Draw crown for king
                if (p == 3) {
                    CircleShape crown(CELL_SIZE * 0.15f);
                    crown.setFillColor(Color(255, 215, 0));
                    crown.setPosition(Vector2f(
                        static_cast<float>(c * CELL_SIZE) + CELL_SIZE * 0.35f,
                        static_cast<float>(r * CELL_SIZE) + CELL_SIZE * 0.3f
                    ));
                    window.draw(crown);
                }
            }
            else if (p == 2 || p == 4) {
                piece.setFillColor(Color(40, 40, 40));
                piece.setPosition(Vector2f(
                    static_cast<float>(c * CELL_SIZE) + CELL_SIZE * 0.15f,
                    static_cast<float>(r * CELL_SIZE) + CELL_SIZE * 0.15f
                ));
                window.draw(piece);

                // Draw crown for king
                if (p == 4) {
                    CircleShape crown(CELL_SIZE * 0.15f);
                    crown.setFillColor(Color(192, 192, 192));
                    crown.setPosition(Vector2f(
                        static_cast<float>(c * CELL_SIZE) + CELL_SIZE * 0.35f,
                        static_cast<float>(r * CELL_SIZE) + CELL_SIZE * 0.3f
                    ));
                    window.draw(crown);
                }
            }
        }
    }
}

void drawMenu(RenderWindow& window, Font& font) {
    window.clear(Color(50, 50, 70));

    Text title(font);
    title.setString("CHECKERS");
    title.setCharacterSize(60);
    title.setFillColor(Color::White);
    title.setStyle(Text::Bold);
    FloatRect titleBounds = title.getLocalBounds();
    title.setPosition(Vector2f(WINDOW_SIZE / 2.f - titleBounds.size.x / 2.f, 80.f));
    window.draw(title);

    Text instructions(font);
    instructions.setString("Click to Start");
    instructions.setCharacterSize(30);
    instructions.setFillColor(Color(200, 200, 200));
    FloatRect instrBounds = instructions.getLocalBounds();
    instructions.setPosition(Vector2f(WINDOW_SIZE / 2.f - instrBounds.size.x / 2.f, 250.f));
    window.draw(instructions);

    Text controls(font);
    controls.setString("Controls:");
    controls.setCharacterSize(20);
    controls.setFillColor(Color(180, 180, 180));
    controls.setPosition(Vector2f(50.f, 320.f));
    window.draw(controls);

    Text control1(font);
    control1.setString("• Click pieces to select and move");
    control1.setCharacterSize(16);
    control1.setFillColor(Color(160, 160, 160));
    control1.setPosition(Vector2f(50.f, 350.f));
    window.draw(control1);

    Text control2(font);
    control2.setString("• Press R to restart");
    control2.setCharacterSize(16);
    control2.setFillColor(Color(160, 160, 160));
    control2.setPosition(Vector2f(50.f, 375.f));
    window.draw(control2);

    Text control3(font);
    control3.setString("• Press S to save / L to load");
    control3.setCharacterSize(16);
    control3.setFillColor(Color(160, 160, 160));
    control3.setPosition(Vector2f(50.f, 400.f));
    window.draw(control3);

    window.display();
}

void drawEndScreen(RenderWindow& window, Font& font, bool playerWon) {
    window.clear(Color(40, 40, 50));

    const char* resultText = playerWon ? "YOU WIN!" : "YOU LOSE!";
    Text result(font);
    result.setString(resultText);
    result.setCharacterSize(70);
    result.setFillColor(playerWon ? Color(100, 255, 100) : Color(255, 100, 100));
    result.setStyle(Text::Bold);
    FloatRect resultBounds = result.getLocalBounds();
    result.setPosition(Vector2f(WINDOW_SIZE / 2.f - resultBounds.size.x / 2.f, 120.f));
    window.draw(result);

    const char* messageText = playerWon ? "Congratulations!" : "Better luck next time!";
    Text message(font);
    message.setString(messageText);
    message.setCharacterSize(25);
    message.setFillColor(Color(200, 200, 200));
    FloatRect msgBounds = message.getLocalBounds();
    message.setPosition(Vector2f(WINDOW_SIZE / 2.f - msgBounds.size.x / 2.f, 220.f));
    window.draw(message);

    Text playAgain(font);
    playAgain.setString("Click to play again");
    playAgain.setCharacterSize(20);
    playAgain.setFillColor(Color(180, 180, 180));
    FloatRect playBounds = playAgain.getLocalBounds();
    playAgain.setPosition(Vector2f(WINDOW_SIZE / 2.f - playBounds.size.x / 2.f, 300.f));
    window.draw(playAgain);

    Text menu(font);
    menu.setString("Press ESC for main menu");
    menu.setCharacterSize(16);
    menu.setFillColor(Color(160, 160, 160));
    FloatRect menuBounds = menu.getLocalBounds();
    menu.setPosition(Vector2f(WINDOW_SIZE / 2.f - menuBounds.size.x / 2.f, 340.f));
    window.draw(menu);

    window.display();
}

int main()
{
    srand(static_cast<unsigned>(time(nullptr)));

    RenderWindow window(VideoMode(Vector2u(WINDOW_SIZE, WINDOW_SIZE)), "Checkers Game");
    window.setFramerateLimit(60);

    Font font;
    if (!font.openFromFile("/System/Library/Fonts/Supplemental/Arial.ttf")) {
        if (!font.openFromFile("C:/Windows/Fonts/arial.ttf")) {
            font.openFromFile("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
        }
    }

    while (window.isOpen())
    {
        while (auto event = window.pollEvent())
        {
            if (event->is<Event::Closed>())
                window.close();

            if (auto* mousePress = event->getIf<Event::MouseButtonPressed>()) {
                if (mousePress->button == Mouse::Button::Left) {
                    if (gameState == STATE_MAIN_MENU) {
                        initBoard();
                        currentPlayer = 1;
                        selectedR = -1;
                        selectedC = -1;
                        gameState = STATE_PLAYING;
                    }
                    else if (gameState == STATE_PLAYER_WON || gameState == STATE_PLAYER_LOST) {
                        initBoard();
                        currentPlayer = 1;
                        selectedR = -1;
                        selectedC = -1;
                        gameState = STATE_PLAYING;
                    }
                    else if (gameState == STATE_PLAYING && currentPlayer == 1) {
                        Vector2i mousePos = Mouse::getPosition(window);
                        int c = mousePos.x / CELL_SIZE;
                        int r = mousePos.y / CELL_SIZE;

                        if (inside(r, c)) {
                            if (selectedR == -1) {
                                if (getPlayer(board[r][c]) == currentPlayer) {
                                    selectedR = r;
                                    selectedC = c;
                                }
                            }
                            else {
                                if (makeMove(selectedR, selectedC, r, c, currentPlayer)) {
                                    selectedR = -1;
                                    selectedC = -1;
                                    currentPlayer = 2;
                                }
                                else if (getPlayer(board[r][c]) == currentPlayer) {
                                    selectedR = r;
                                    selectedC = c;
                                }
                                else {
                                    selectedR = -1;
                                    selectedC = -1;
                                }
                            }
                        }
                    }
                }
            }

            if (event->is<Event::KeyPressed>()) {
                auto* keyPress = event->getIf<Event::KeyPressed>();

                if (keyPress->code == Keyboard::Key::Escape) {
                    gameState = STATE_MAIN_MENU;
                }

                if (gameState == STATE_PLAYING) {
                    if (keyPress->code == Keyboard::Key::S) {
                        saveBoard("checkers_save.txt");
                    }
                    if (keyPress->code == Keyboard::Key::L) {
                        loadBoard("checkers_save.txt");
                    }
                    if (keyPress->code == Keyboard::Key::R) {
                        initBoard();
                        currentPlayer = 1;
                        selectedR = -1;
                        selectedC = -1;
                    }
                }
            }
        }

        if (gameState == STATE_PLAYING) {
            // AI turn
            if (currentPlayer == 2) {
                sleep(milliseconds(500));
                aiMove();
                currentPlayer = 1;
            }

            // Check win/lose conditions
            if (!hasAnyPieces(2) || !hasValidMoves(2)) {
                gameState = STATE_PLAYER_WON;
            }
            else if (!hasAnyPieces(1) || !hasValidMoves(1)) {
                gameState = STATE_PLAYER_LOST;
            }

            window.clear();
            drawBoard(window);
            window.display();
        }
        else if (gameState == STATE_MAIN_MENU) {
            drawMenu(window, font);
        }
        else if (gameState == STATE_PLAYER_WON || gameState == STATE_PLAYER_LOST) {
            drawEndScreen(window, font, gameState == STATE_PLAYER_WON);
        }
    }
    return 0;
}
